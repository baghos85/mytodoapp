{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["azure", "playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 60,
            "statusMessage": "Formatting file..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__azure", "mcp__playwright",

      "Bash(dotnet build *)", "Bash(dotnet test *)", "Bash(dotnet format *)", "Bash(dotnet restore *)",
      "Bash(dotnet run *)", "Bash(dotnet ef *)", "Bash(dotnet new *)", "Bash(dotnet add *)",
      "Bash(dotnet sln *)", "Bash(dotnet user-secrets *)", "Bash(dotnet --*)", "Bash(dotnet list *)",
      "PowerShell(dotnet build *)", "PowerShell(dotnet test *)", "PowerShell(dotnet format *)", "PowerShell(dotnet restore *)",
      "PowerShell(dotnet run *)", "PowerShell(dotnet ef *)", "PowerShell(dotnet new *)", "PowerShell(dotnet add *)",
      "PowerShell(dotnet sln *)", "PowerShell(dotnet user-secrets *)", "PowerShell(dotnet --*)", "PowerShell(dotnet list *)",

      "Bash(npm install *)", "Bash(npm ci *)", "Bash(npm run *)", "Bash(npm test *)", "Bash(npm ls *)",
      "Bash(npx playwright *)", "Bash(npx tsc *)", "Bash(npx eslint *)", "Bash(npx prettier *)", "Bash(npx vitest *)",
      "Bash(node --version)",
      "PowerShell(npm install *)", "PowerShell(npm ci *)", "PowerShell(npm run *)", "PowerShell(npm test *)", "PowerShell(npm ls *)",
      "PowerShell(npx playwright *)", "PowerShell(npx tsc *)", "PowerShell(npx eslint *)", "PowerShell(npx prettier *)", "PowerShell(npx vitest *)",
      "PowerShell(node --version)",

      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)", "Bash(git add *)",
      "Bash(git commit *)", "Bash(git checkout *)", "Bash(git switch *)", "Bash(git branch *)",
      "Bash(git pull *)", "Bash(git fetch *)", "Bash(git push *)", "Bash(git stash *)", "Bash(git worktree *)",
      "Bash(git rev-parse *)", "Bash(git remote -v)",
      "PowerShell(git status *)", "PowerShell(git diff *)", "PowerShell(git log *)", "PowerShell(git show *)", "PowerShell(git add *)",
      "PowerShell(git commit *)", "PowerShell(git checkout *)", "PowerShell(git switch *)", "PowerShell(git branch *)",
      "PowerShell(git pull *)", "PowerShell(git fetch *)", "PowerShell(git push *)", "PowerShell(git stash *)", "PowerShell(git worktree *)",
      "PowerShell(git rev-parse *)", "PowerShell(git remote -v)",

      "Bash(gh issue *)", "Bash(gh pr *)", "Bash(gh label *)", "Bash(gh repo view *)", "Bash(gh run *)",
      "Bash(gh workflow *)", "Bash(gh auth status)", "Bash(gh secret list *)",
      "PowerShell(gh issue *)", "PowerShell(gh pr *)", "PowerShell(gh label *)", "PowerShell(gh repo view *)", "PowerShell(gh run *)",
      "PowerShell(gh workflow *)", "PowerShell(gh auth status)", "PowerShell(gh secret list *)",

      "Bash(az account show *)", "Bash(az * show *)", "Bash(az * list *)", "Bash(az bicep *)",
      "Bash(az deployment group what-if *)", "Bash(az deployment group validate *)",
      "PowerShell(az account show *)", "PowerShell(az * show *)", "PowerShell(az * list *)", "PowerShell(az bicep *)",
      "PowerShell(az deployment group what-if *)", "PowerShell(az deployment group validate *)",

      "Bash(docker build *)", "Bash(docker compose *)", "Bash(docker images *)", "Bash(docker ps *)",
      "PowerShell(docker build *)", "PowerShell(docker compose *)", "PowerShell(docker images *)", "PowerShell(docker ps *)"
    ],
    "ask": [
      "Bash(git push origin main*)", "Bash(git push -u origin main*)",
      "PowerShell(git push origin main*)", "PowerShell(git push -u origin main*)"
    ],
    "deny": [
      "Bash(az group delete *)", "Bash(az * delete *)", "Bash(az deployment group create *)", "Bash(az deployment sub create *)",
      "Bash(az role assignment create *)", "Bash(az ad *)",
      "PowerShell(az group delete *)", "PowerShell(az * delete *)", "PowerShell(az deployment group create *)", "PowerShell(az deployment sub create *)",
      "PowerShell(az role assignment create *)", "PowerShell(az ad *)",

      "Bash(rm -rf *)", "Bash(rm -fr *)", "Bash(rm -r -f *)",
      "PowerShell(rm -rf *)", "PowerShell(Remove-Item * -Recurse*)", "PowerShell(rm * -Recurse*)", "PowerShell(rd /s *)",

      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push * --force*)", "Bash(git push * -f*)",
      "Bash(git push * +main*)", "Bash(git reset --hard origin/main*)", "Bash(git branch -D main*)",
      "PowerShell(git push --force*)", "PowerShell(git push -f*)", "PowerShell(git push * --force*)", "PowerShell(git push * -f*)",
      "PowerShell(git push * +main*)", "PowerShell(git reset --hard origin/main*)", "PowerShell(git branch -D main*)",

      "Bash(gh pr merge *)", "Bash(gh pr review * --approve*)", "Bash(gh pr review * -a*)",
      "Bash(gh secret set *)", "Bash(gh secret delete *)", "Bash(gh repo delete *)", "Bash(gh repo edit *)",
      "Bash(gh api * -X DELETE*)", "Bash(gh api * --method DELETE*)",
      "PowerShell(gh pr merge *)", "PowerShell(gh pr review * --approve*)", "PowerShell(gh pr review * -a*)",
      "PowerShell(gh secret set *)", "PowerShell(gh secret delete *)", "PowerShell(gh repo delete *)", "PowerShell(gh repo edit *)",
      "PowerShell(gh api * -X DELETE*)", "PowerShell(gh api * --method DELETE*)",

      "Read(**/.env)", "Read(**/.env.*)", "Read(**/*.pfx)", "Read(**/*.pem)", "Read(**/*.key)",
      "Read(**/appsettings.*.local.json)", "Read(**/*.publishsettings)"
    ]
  }
}
