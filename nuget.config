<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from nuget.org, regardless of package sources configured on the machine.
  Central package management (Directory.Packages.props) fails with NU1507 when several sources are defined.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
