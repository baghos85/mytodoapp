<Project>

  <!--
    Central package versions for the runtime projects (ADR-025 baseline only; ask before adding a package).
    Lives in src/backend for the same reason as Directory.Build.props; the root Directory.Packages.props
    imports it and adds the test packages.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
  </ItemGroup>

</Project>
