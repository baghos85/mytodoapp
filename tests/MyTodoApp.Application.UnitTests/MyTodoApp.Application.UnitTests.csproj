    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Handlers are tested against the real Infrastructure (AppDbContext on SQLite in-memory, ADR-022). -->
    <ProjectReference Include="..\..\src\backend\MyTodoApp.Application\MyTodoApp.Application.csproj" />
    <ProjectReference Include="..\..\src\backend\MyTodoApp.Infrastructure\MyTodoApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
